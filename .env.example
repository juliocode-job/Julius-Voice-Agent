# Julius Voice Agent Environment Variables Example
# Copy this file to .env and fill in your actual credentials

# Groq Configuration
USE_GROQ=True
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Configuration (Fallback)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=your_custom_secret_string_here
MY_WHATSAPP_NUMBER=5581999990000   # your number with country code, no + or spaces

# Agent behavior
AGENT_LANGUAGE=en
AGENT_PROMPT_FILE=prompts/interviewer_prompt.txt
